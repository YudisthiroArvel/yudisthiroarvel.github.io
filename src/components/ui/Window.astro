---
// A classic-OS style window frame. Reusable for terminals, project cards, etc.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="window">
  <div class="window__bar">
    <span class="window__close" aria-hidden="true"></span>
    <span class="window__title">{title}</span>
  </div>
  <div class="window__body">
    <slot />
  </div>
</div>

<style>
  .window {
    border: 2px solid var(--color-text);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    box-shadow: 8px 8px 0 0 var(--color-primary-strong);
    overflow: hidden;
  }

  /* Title bar with the horizontal pinstripes of early Mac OS */
  .window__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    padding-inline: var(--space-3);
    border-bottom: 2px solid var(--color-text);
    background:
      repeating-linear-gradient(
          to bottom,
          rgb(244 239 255 / 0.55) 0 2px,
          transparent 2px 4px
        )
        center / calc(100% - 1.5rem) 14px no-repeat,
      var(--color-primary-strong);
  }

  .window__close {
    position: absolute;
    left: var(--space-3);
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-text);
    background: var(--color-primary-strong);
  }

  .window__title {
    position: relative;
    padding-inline: var(--space-3);
    background: var(--color-primary-strong);
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .window__body {
    padding: var(--space-5);
  }
</style>
