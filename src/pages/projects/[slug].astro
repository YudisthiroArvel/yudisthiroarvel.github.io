---
// One case-study page per Markdown file in src/content/projects/.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import Navbar from "../../components/layout/Navbar.astro";
import ProjectMedia from "../../components/projects/ProjectMedia.astro";
import Button from "../../components/ui/Button.astro";
import Chip from "../../components/ui/Chip.astro";
import { getSortedProjects, projectUrl, type Project } from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getSortedProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const meta = [
  { label: "year", value: data.year },
  { label: "role", value: data.role },
  { label: "context", value: data.context },
  { label: "team", value: data.team },
];
---

<BaseLayout title={data.title} description={data.summary}>
  <Navbar />
  <main id="main" class="case">
    <div class="container">
      <a href="/#projects" class="case__back">← cd ../projects</a>

      <header class="case__header">
        <ul class="case__tags" role="list">
          {
            data.tags.map((tag) => (
              <li>
                <Chip>{tag}</Chip>
              </li>
            ))
          }
        </ul>
        <h1 class="case__title">{data.title}</h1>
        <p class="case__summary">{data.summary}</p>

        <dl class="case__meta">
          {
            meta.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          data.links.length > 0 && (
            <div class="case__links">
              {data.links.map((link) => (
                <Button href={link.href} variant="ghost" size="sm" external>
                  {link.label} ↗
                </Button>
              ))}
            </div>
          )
        }
      </header>

      <div class="case__media">
        <ProjectMedia data={data} variant="full" />
      </div>

      <div class="case__content">
        <article class="prose">
          <Content />
        </article>

        <aside class="case__aside" aria-label="Tools used">
          <p class="case__aside-title">// stack</p>
          <ul class="case__stack" role="list">
            {
              data.stack.map((item) => (
                <li>
                  <Chip>{item}</Chip>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>

      <nav class="case__next" aria-label="Next project">
        <a href={projectUrl(next)}>
          <span class="case__next-label">next project →</span>
          <span class="case__next-title">{next.data.title}</span>
        </a>
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case {
    padding-block: calc(var(--nav-height) + var(--space-12)) var(--space-20);
  }

  .case__back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
    transition: color var(--duration-fast);
  }

  .case__back:hover {
    color: var(--color-accent);
  }

  .case__header {
    max-width: 52rem;
    margin-top: var(--space-10);
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .case__title {
    margin-top: var(--space-5);
    font-size: var(--text-3xl);
    letter-spacing: -0.035em;
  }

  .case__summary {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .case__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-10);
    padding-block: var(--space-5);
    border-block: 2px dashed var(--color-line-strong);
  }

  .case__meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-primary);
  }

  .case__meta dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .case__media {
    margin-top: var(--space-12);
    border: 2px solid var(--color-text);
    border-radius: var(--radius-md);
    box-shadow: 8px 8px 0 0 var(--color-primary-strong);
    overflow: hidden;
  }

  .case__content {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-16);
  }

  @media (min-width: 960px) {
    .case__content {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: var(--space-16);
      align-items: start;
    }

    .case__aside {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-8));
    }
  }

  .case__aside-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* Styles for the Markdown body; :global() reaches into the rendered HTML */
  .prose {
    max-width: 65ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    font-family: var(--font-pixel);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin-top: var(--space-4);
  }

  .prose :global(code) {
    padding: 0.1em 0.4em;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .case__next {
    margin-top: var(--space-20);
    border-top: 2px solid var(--color-line);
  }

  .case__next a {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-8);
  }

  .case__next-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-primary);
  }

  .case__next-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color var(--duration-fast);
  }

  .case__next a:hover .case__next-title {
    color: var(--color-accent);
  }
</style>
