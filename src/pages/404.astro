---
// GitHub Pages serves this file (built as /404.html) for any URL that doesn't exist.
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import Button from "../components/ui/Button.astro";
import Window from "../components/ui/Window.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <Navbar />
  <main id="main" class="not-found">
    <div class="container not-found__inner">
      <h1 class="not-found__code text-pixel">404</h1>
      <p class="not-found__text">This page doesn't exist (yet).</p>

      <div class="not-found__window">
        <Window title="terminal — error.log">
          <p class="term"><span class="term__prompt">$</span> cd <span data-path>/that-page</span></p>
          <p class="term term--error">bash: cd: no such file or directory</p>
          <p class="term"><span class="term__prompt">$</span> <span class="cursor" aria-hidden="true"></span></p>
        </Window>
      </div>

      <div class="not-found__actions">
        <Button href="/" arrow>Back home</Button>
        <Button href="/#projects" variant="ghost">See projects</Button>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const path = document.querySelector("[data-path]");
  if (path) path.textContent = window.location.pathname;
</script>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    padding-block: calc(var(--nav-height) + var(--space-12)) var(--space-16);
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-6);
    text-align: center;
  }

  .not-found__code {
    font-size: clamp(6rem, 4rem + 12vw, 12rem);
    line-height: 0.9;
  }

  .not-found__text {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
  }

  .not-found__window {
    width: min(100%, 32rem);
    margin-top: var(--space-4);
    text-align: left;
  }

  .term {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .term__prompt {
    color: var(--color-accent);
  }

  .term--error {
    color: var(--color-pink);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
